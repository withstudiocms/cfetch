{
  "name": "@studiocms/cfetch",
  "version": "0.4.0",
  "description": "Astro integration that allows you to have a cached fetch function in your Astro SSR project.",
  "license": "MIT",
  "homepage": "https://studiocms.dev",
  "sideEffects": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withstudiocms/cfetch.git",
    "directory": "packages/cfetch"
  },
  "author": {
    "name": "Adam Matthiesen | Jacob Jenkins | Paul Valladares",
    "url": "https://studiocms.dev"
  },
  "contributors": [
    "Adammatthiesen",
    "jdtjenkins",
    "dreyfus92",
    "code.spirit"
  ],
  "keywords": [
    "astro",
    "astrocms",
    "astrodb",
    "astrostudio",
    "astro-integration",
    "astro-studio",
    "astro-studiocms",
    "studiocms",
    "withastro"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts --clean",
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "effect-check": "pnpm effect-language-service diagnostics --project tsconfig.tspc.json",
    "typecheck": "tspc -p tsconfig.tspc.json",
    "jsr": "jsr publish",
    "ci:effect-check": "pnpm effect-check --format github-actions"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "default": "./dist/types.mjs"
    }
  },
  "devDependencies": {
    "@inox-tools/astro-tests": "^0.9.1",
    "@types/node": "^22.0.0",
    "jest-extended": "^7.0.0",
    "astro": "^5.17.3",
    "effect": "^3.19.19"
  },
  "peerDependencies": {
    "astro": ">=5.16.6",
    "effect": "^3.19.13",
    "vite": "^6.4.1"
  }
}
